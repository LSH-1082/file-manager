# 이 파일을 .env로 복사해 값을 바꾼다. docker compose가 같은 폴더의 .env를 읽는다.
# 값에 $를 쓰려면 $$로 적는다.
# 비밀번호는 MySQL 볼륨이 비어 있는 첫 기동 때만 적용되므로 바꾸면 docker compose down -v 뒤 다시 띄운다.
FILEMANAGER_DB_USERNAME=fileManager
FILEMANAGER_DB_PASSWORD=fileManager1!
MYSQL_ROOT_PASSWORD=fileManagerRoot1!
FRONTEND_PORT=3000

# 파일 본문 저장 공유(SMB). backend-storage 볼륨이 //FILEMANAGER_SMB_HOST/FILEMANAGER_SMB_SHARE를 CIFS로 /app/data/storage에 마운트한다.
# 사용자·비밀번호는 필수이며 실제 값은 .env에만 적고 이 파일에는 쓰지 않는다. 비밀번호에 쉼표는 쓸 수 없고 $는 $$로 적는다.
FILEMANAGER_SMB_HOST=192.168.0.8
FILEMANAGER_SMB_SHARE=Media/repository
FILEMANAGER_SMB_USERNAME=
FILEMANAGER_SMB_PASSWORD=
# SMB 버전. 192.168.0.8 공유는 3.x를 받지 않아 2.1이다. operation not supported 오류가 나면 이 값을 확인한다.
FILEMANAGER_SMB_VERS=2.1

# MySQL 백업(docker compose run --rm mysql-backup). 덤프 파일을 //FILEMANAGER_SMB_HOST/FILEMANAGER_MYSQL_BACKUP_SHARE에 fileManager_<UTC 시각>.sql.gz로 쓴다.
# SMB 주소·사용자·비밀번호·버전은 위 FILEMANAGER_SMB_* 값을 함께 쓴다. MySQL 접속은 MYSQL_ROOT_PASSWORD를 쓴다.
# FILEMANAGER_MYSQL_BACKUP_KEEP_DAYS를 1 이상으로 주면 백업할 때 그 일수보다 오래된 fileManager_*.sql.gz를 지운다. 0이면 지우지 않는다.
FILEMANAGER_MYSQL_BACKUP_SHARE=Media/MySQL
FILEMANAGER_MYSQL_BACKUP_KEEP_DAYS=0
